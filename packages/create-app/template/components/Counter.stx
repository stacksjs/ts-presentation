<script client>
const props = defineProps()
const count = state(props.start ?? 0)

function decrement() { count.value-- }
function increment() { count.value++ }
</script>

<template>
  <div class="demo-counter">
    <button type="button" aria-label="Decrease counter" @click="decrement">−</button>
    <output aria-live="polite">{{ count }}</output>
    <button type="button" aria-label="Increase counter" @click="increment">+</button>
  </div>
</template>

<style scoped>
.demo-counter {
  display: inline-flex;
  align-items: center;
  gap: 0.75em;
  font-variant-numeric: tabular-nums;
}

.demo-counter button {
  min-width: 2em;
  min-height: 2em;
}

.demo-counter output {
  min-width: 2ch;
  text-align: center;
}
</style>
