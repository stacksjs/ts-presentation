{
  "name": "ts-presentation",
  "version": "0.1.0",
  "type": "module",
  "description": "A Bun and TypeScript presentation toolkit based on Slidev.",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/ts-presentation.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "ts-presentation": "./src/cli.ts",
    "create-ts-presentation": "./packages/create-app/index.mjs",
    "create-ts-presentation-theme": "./packages/create-theme/index.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./parser": "./packages/parser/src/index.ts",
    "./types": "./packages/types/src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts dev examples/demo/slides.md",
    "build": "bun src/cli.ts build examples/demo/slides.md",
    "export": "bun src/cli.ts export examples/demo/slides.md --out output/demo.pdf",
    "format": "pickier run --mode format",
    "lint": "pickier run --mode lint",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ts-charts": "https://codeload.github.com/stacksjs/ts-charts/tar.gz/9f2d5c689bff3d336e70daa21714382cf91af087",
    "ts-syntax-highlighter": "^0.2.20",
    "@stacksjs/stx": "0.2.919"
  },
  "devDependencies": {
    "better-dx": "^0.2.15"
  },
  "files": [
    "licenses",
    "README.md",
    "LICENSE.md",
    "src",
    "skills",
    "packages/client/index.ts",
    "packages/client/runtime",
    "packages/client/logic/tweet.ts",
    "packages/client/layouts/*.stx",
    "packages/create-app/index.mjs",
    "packages/create-app/scaffold.mjs",
    "packages/create-app/template/{README.md,_gitignore,package.json,slides.md}",
    "packages/create-app/template/components/*.stx",
    "packages/create-theme/index.mjs",
    "packages/create-theme/template/{README.md,_gitignore,example.md,index.ts,package.json,styles/layout.css}",
    "packages/create-theme/template/layouts/*.stx",
    "packages/parser/src",
    "packages/types/src",
    "packages/slidev/bin/slidev.mjs",
    "packages/slidev/node/{cli.ts,index.ts}",
    "packages/slidev/node/runtime",
    "packages/slidev/node/mcp",
    "!packages/parser/src/**/*.test.ts"
  ],
  "workspaces": [
    "packages/*"
  ]
}
