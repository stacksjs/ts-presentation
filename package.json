{
  "name": "ts-presentation",
  "version": "0.1.0",
  "type": "module",
  "description": "A Bun and TypeScript presentation toolkit based on Slidev.",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/ts-presentation.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "ts-presentation": "./src/cli.ts",
    "create-ts-presentation": "./packages/create-app/index.mjs",
    "create-ts-presentation-theme": "./packages/create-theme/index.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./parser": "./packages/parser/src/index.ts",
    "./parser/core": "./packages/parser/src/core.ts",
    "./parser/fs": "./packages/parser/src/fs.ts",
    "./parser/utils": "./packages/parser/src/utils.ts",
    "./types": "./packages/types/src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts dev examples/demo/slides.md",
    "build": "bun src/cli.ts build examples/demo/slides.md",
    "export": "bun src/cli.ts export examples/demo/slides.md --out output/demo.pdf",
    "format": "pickier run --mode format",
    "lint": "pickier run --mode lint",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "buddy": "bun --bun ./node_modules/.bin/buddy",
    "changelog": "bun --bun logsmith --verbose",
    "changelog:generate": "bun --bun logsmith --output CHANGELOG.md",
    "release": "bun --bun bumpx prompt --recursive",
    "release:patch": "bun --bun bumpx patch --recursive --commit --tag --push --yes"
  },
  "dependencies": {
    "@stacksjs/stx": "https://registry.pantry.dev/@stacksjs/stx@bf7ed0c",
    "ts-charts": "https://codeload.github.com/stacksjs/ts-charts/tar.gz/aeecb1af5ce5415fb65447bfb1fcf976fefc83ce",
    "ts-syntax-highlighter": "^0.2.20"
  },
  "devDependencies": {
    "better-dx": "^0.2.15"
  },
  "overrides": {
    "@buddysh/buddy": "https://registry.pantry.dev/@buddysh/buddy@f5dfd38",
    "@stacksjs/stx": "https://registry.pantry.dev/@stacksjs/stx@bf7ed0c"
  },
  "files": [
    "licenses",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "src",
    "skills",
    "packages/client/index.ts",
    "packages/client/runtime",
    "packages/client/logic/tweet.ts",
    "packages/client/layouts/content.stx",
    "packages/client/layouts/iframe-left.stx",
    "packages/client/layouts/iframe-right.stx",
    "packages/client/layouts/iframe.stx",
    "packages/client/layouts/image-element.stx",
    "packages/client/layouts/image-split.stx",
    "packages/client/layouts/image.stx",
    "packages/client/layouts/two-cols-header.stx",
    "packages/client/layouts/two-cols.stx",
    "packages/create-app/index.mjs",
    "packages/create-app/scaffold.mjs",
    "packages/create-app/template/README.md",
    "packages/create-app/template/_gitignore",
    "packages/create-app/template/package.json",
    "packages/create-app/template/slides.md",
    "packages/create-app/template/components",
    "packages/create-theme/index.mjs",
    "packages/create-theme/template/README.md",
    "packages/create-theme/template/_gitignore",
    "packages/create-theme/template/example.md",
    "packages/create-theme/template/index.ts",
    "packages/create-theme/template/package.json",
    "packages/create-theme/template/styles/layout.css",
    "packages/create-theme/template/layouts/cover.stx",
    "packages/parser/src/comark.ts",
    "packages/parser/src/config.ts",
    "packages/parser/src/core.ts",
    "packages/parser/src/deck.ts",
    "packages/parser/src/fs.ts",
    "packages/parser/src/index.ts",
    "packages/parser/src/markdown-fences.ts",
    "packages/parser/src/plain-markdown.ts",
    "packages/parser/src/timesplit/index.ts",
    "packages/parser/src/timesplit/timesplit.ts",
    "packages/parser/src/timesplit/timestring.ts",
    "packages/parser/src/utils.ts",
    "packages/types/src",
    "packages/slidev/bin/slidev.mjs",
    "packages/slidev/node/cli.ts",
    "packages/slidev/node/index.ts",
    "packages/slidev/node/runtime",
    "packages/slidev/node/mcp"
  ],
  "workspaces": [
    "packages/*"
  ]
}
